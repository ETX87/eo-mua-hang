{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muahang",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],

  // BAT BUOC - thieu no thi request navigate that (Sec-Fetch-Mode: navigate) bi Workers Static
  // Assets SPA fallback chan truoc khi toi Worker. curl KHONG tai hien loi nay. KHONG xoa.
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // database_id la PLACEHOLDER - dien sau khi chay "wrangler d1 create eo-mua-hang-db" (xem DEPLOY.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eo-mua-hang-db",
      "database_id": "4e77bcda-10f1-4a60-bb16-0e7a0eb85ebc",
      "migrations_dir": "migrations"
    }
  ],

  // Khong cron, khong R2 (xem TARGET_ARCHITECTURE.md).

  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "smarttrade.vp@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://muahang.dichvu3t.workers.dev/api/auth/callback",
    "FRONTEND_URL": "https://muahang.dichvu3t.workers.dev"
  }

  // Gia tri NHAY CAM (dat qua "wrangler secret put", KHONG de trong "vars"):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET
}
